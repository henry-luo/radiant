{
  "targets": [
    {
      "name": "radiant",
      "description": "Static Radiant layout, rendering, and UI layer",
      "pic_linux": true,
      "lang": "c++17",
      "source_patterns": [
        "radiant/*.cpp",
        "radiant/scene3d/*.cpp",
        "radiant/paint/*.cpp"
      ],
      "libraries": [
        "lambda-data",
        "lambda-lib",
        "fribidi",
        "ThorVG",
        "glfw",
        "image-codecs",
        "pthread"
      ],
      "macos": {
        "additional_libraries": [
          "CoreFoundation",
          "Security",
          "CoreServices",
          "SystemConfiguration",
          "Cocoa",
          "IOKit",
          "CoreVideo",
          "AVFoundation",
          "AudioToolbox",
          "CoreMedia",
          "GL",
          "Foundation",
          "CoreGraphics",
          "Accelerate",
          "CoreText",
          "AppKit",
          "Carbon",
          "WebKit"
        ]
      },
      "linux": {
        "additional_libraries": [
          "GL",
          "GLU",
          "gomp",
          "webkit2gtk-4.1",
          "gtk+-3.0",
          "glib-2.0",
          "gio-2.0",
          "gobject-2.0",
          "cairo",
          "javascriptcoregtk-4.1"
        ]
      },
      "windows": {
        "exclude_libraries": [
          "fribidi"
        ]
      },
      "link": "static",
      "source_sets": [
        {
          "platforms": [
            "macos"
          ],
          "exclude_patterns": [
            "radiant/rdt_video_stub.cpp",
            "radiant/rdt_speech_stub.cpp"
          ],
          "objcxx_source_files": [
            "radiant/audio_capture_mac_static.cpp",
            "radiant/app_icon_mac_static.cpp",
            "radiant/clipboard_mac_static.cpp",
            "radiant/ime_mac_static.cpp",
            "radiant/webview_child_mac_static.cpp",
            "radiant/webview_layer_mac_static.cpp",
            "radiant/rdt_video_mac_static.cpp",
            "radiant/rdt_speech_mac_static.cpp"
          ]
        },
        {
          "platforms": [
            "linux",
            "windows"
          ],
          "exclude_patterns": [
            "radiant/rdt_video_mac_static.cpp",
            "radiant/rdt_speech_mac_static.cpp"
          ]
        }
      ]
    }
  ]
}
