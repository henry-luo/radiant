{
  "name": "Dark select selected option remains readable when the pointer leaves",
  "viewport": {"width": 400, "height": 240},
  "events": [
    {"type": "click", "target": {"selector": "#dark"}},
    {"type": "assert_pixel", "x": 180, "y": 80, "max_r": 5, "min_g": 115, "max_g": 125, "min_b": 210, "max_b": 220},
    {"type": "assert_pixel", "x": 30, "y": 80, "min_r": 240, "min_g": 240, "min_b": 240},
    {"type": "mouse_move", "x": 350, "y": 180},
    {"type": "assert_state_store", "target": {"selector": "#dark"}, "open_dropdown": true},
    {"type": "assert_pixel", "x": 180, "y": 80, "min_r": 225, "max_r": 235, "min_g": 225, "max_g": 235, "min_b": 225, "max_b": 235},
    {"type": "assert_pixel", "x": 30, "y": 80, "max_r": 80, "max_g": 80, "max_b": 80}
  ]
}
